---
import { getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import BlogCard from "../../../../components/BlogCard.astro";
import { useTranslations, getCategoryLabel } from "../../../../i18n/utils";
import { extractHeroImage } from "../../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", (post) => post.data.lang === "en");
  const uniqueSlugs = [...new Set(allPosts.map((post) => post.data.categorySlug))];

  return uniqueSlugs.map((categorySlug) => ({
    params: { category: categorySlug },
  }));
}

const { category } = Astro.params;

const lang = "en";
const t = useTranslations(lang);

const posts = (await getCollection("blog", (post) => post.data.lang === "en"))
  .filter((post) => post.data.categorySlug === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryName = getCategoryLabel(lang, category, posts[0]?.data.category ?? category);
const title = `${categoryName} | ${t("blog.title")}`;
const description = `${t("blog.title")} articles in the ${categoryName} category.`;
---

<Layout lang={lang} title={title} description={description}>
  <Header lang={lang} />
  <main class="py-section-gap">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="mb-10">
        <a href="/en/blog" class="text-label-caps text-on-surface-variant hover:text-primary transition-colors duration-300">
          {t("blog.back")}
        </a>
      </div>

      <div class="text-center mb-16">
        <span class="text-label-caps text-primary">{t("blog.title")}</span>
        <h1 class="text-headline-md text-on-background font-serif italic mt-2">{categoryName}</h1>
        <div class="w-12 h-px bg-primary mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              category={categoryName}
              categoryUrl={`/en/blog/category/${post.data.categorySlug}`}
              url={`/en/blog/${post.id.replace(/-en$/, "")}`}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage ?? extractHeroImage(post.body)}
              lang={lang}
            />
          ))
        }
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
