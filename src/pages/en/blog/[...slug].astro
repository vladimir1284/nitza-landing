---
import { getCollection, render } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import { extractHeroImage } from "../../../utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (post) => post.data.lang === "en");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/-en$/, "") },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
const heroImage = post.data.heroImage ?? extractHeroImage(post.body);
---

<BlogPost {...post.data} heroImage={heroImage}>
  <Content />
</BlogPost>
