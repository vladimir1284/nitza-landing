---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { useTranslations } from "../../../i18n/utils";
import { extractHeroImage } from "../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", (post) => post.data.lang !== "en");
  const uniqueSlugs = [...new Set(allPosts.map((post) => post.data.categorySlug))];

  return uniqueSlugs.map((categorySlug) => {
    const categoryName = allPosts.find((p) => p.data.categorySlug === categorySlug)?.data.category ?? categorySlug;
    return {
      params: { category: categorySlug },
      props: { categoryName },
    };
  });
}

const { category } = Astro.params;
const { categoryName } = Astro.props;

const lang = "es";
const t = useTranslations(lang);

const posts = (await getCollection("blog", (post) => post.data.lang !== "en"))
  .filter((post) => post.data.categorySlug === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `${categoryName} | ${t("blog.title")}`;
const description = `Artículos de la categoría ${categoryName} en ${t("blog.title")}.`;
---

<Layout lang={lang} title={title} description={description}>
  <Header lang={lang} />
  <main class="py-section-gap">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="mb-10">
        <a href="/blog" class="text-label-caps text-on-surface-variant hover:text-primary transition-colors duration-300">
          ← Volver al Blog
        </a>
      </div>

      <div class="text-center mb-16">
        <span class="text-label-caps text-primary">{t("blog.title")}</span>
        <h1 class="text-headline-md text-on-background font-serif italic mt-2">{categoryName}</h1>
        <div class="w-12 h-px bg-primary mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        {
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              categoryUrl={`/blog/category/${post.data.categorySlug}`}
              url={`/blog/${post.id}`}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage ?? extractHeroImage(post.body)}
              lang={lang}
            />
          ))
        }
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
