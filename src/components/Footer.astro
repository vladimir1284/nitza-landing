---
import { useTranslations, getLocalizedPath, type Lang } from "../i18n/utils";
import WhatsAppLink from "./ui/WhatsAppLink.astro";
import ObfuscatedLink from "./ui/ObfuscatedLink.astro";
import SocialIcons from "./ui/SocialIcons.astro";
import { EMAIL } from "../lib/contact";
import { LEGAL_ADDRESS_LINE1, LEGAL_ADDRESS_LINE2, LEGAL_PHONE, LEGAL_PHONE_DISPLAY } from "../lib/legal";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const home = getLocalizedPath(lang, "/");
const privacyPath = getLocalizedPath(lang, "/privacy");
const termsPath = getLocalizedPath(lang, "/terms");
const blogPath = getLocalizedPath(lang, "/blog");
---

<footer class="w-full bg-surface-container-highest border-t border-outline-variant/50">
  <div
    class="flex flex-col md:flex-row justify-between items-start w-full px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max mx-auto"
  >
    <div class="mb-8 md:mb-0">
      <span class="flex items-center gap-3 mb-4">
        <img src="/logo.svg" alt="" class="w-8 h-8" aria-hidden="true" />
        <span class="text-3xl md:text-4xl text-primary font-script font-normal normal-case">{t("nav.brand")}</span>
      </span>
      <p
        class="text-body-md text-on-surface-variant"
        set:html={t("footer.copyright")
          .replace("{year}", String(year))
          .replace("Nitza Develop", '<span class="font-script text-[1.15em] font-normal">Nitza Develop</span>')}
      ></p>
      <SocialIcons class="mt-6" />
    </div>
    <div class="flex flex-col md:flex-row gap-8 md:gap-16">
      <div class="flex flex-col gap-4">
        <a
          class="text-body-md text-on-surface-variant hover:text-primary hover:underline underline-offset-4 transition-all duration-200 ease-in-out"
          href={`${home}#team`}
        >
          {t("footer.manifesto")}
        </a>
        <a
          class="text-body-md text-on-surface-variant hover:text-primary hover:underline underline-offset-4 transition-all duration-200 ease-in-out"
          href={`${home}#menu`}
        >
          {t("footer.kitchen")}
        </a>
        <a
          class="text-body-md text-on-surface-variant hover:text-primary hover:underline underline-offset-4 transition-all duration-200 ease-in-out"
          href={`${home}#contact`}
        >
          {t("footer.contact")}
        </a>
        <a
          class="text-body-md text-on-surface-variant hover:text-primary hover:underline underline-offset-4 transition-all duration-200 ease-in-out"
          href={blogPath}
        >
          {t("nav.blog")}
        </a>
      </div>
      <div class="flex flex-col gap-4">
        <WhatsAppLink
          message={t("cta.whatsappMessage")}
          class="text-body-md text-on-surface-variant hover:text-primary hover:underline underline-offset-4 transition-all duration-200 ease-in-out"
        >
          {t("footer.privateDining")}
        </WhatsAppLink>
        <ObfuscatedLink
          scheme="mailto"
          value={EMAIL}
          class="text-body-md text-on-surface-variant hover:text-primary hover:underline underline-offset-4 transition-all duration-200 ease-in-out"
        >
          {t("footer.email")}
        </ObfuscatedLink>
      </div>
    </div>
  </div>
  <div
    class="w-full px-margin-mobile md:px-margin-desktop py-6 max-w-container-max mx-auto border-t border-outline-variant/50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
  >
    <p class="text-label-caps text-on-surface-variant/70 normal-case tracking-normal font-normal">
      {t("footer.legalEntity")} · {LEGAL_ADDRESS_LINE1}, {LEGAL_ADDRESS_LINE2} ·{" "}
      <ObfuscatedLink scheme="tel" value={LEGAL_PHONE} class="hover:text-primary hover:underline underline-offset-4">
        {LEGAL_PHONE_DISPLAY}
      </ObfuscatedLink>
      · {t("footer.legalJurisdiction")}
    </p>
    <div class="flex gap-6">
      <a
        class="text-label-caps text-on-surface-variant/70 hover:text-primary hover:underline underline-offset-4 normal-case tracking-normal font-normal transition-all duration-200 ease-in-out"
        href={privacyPath}
      >
        {t("footer.privacy")}
      </a>
      <a
        class="text-label-caps text-on-surface-variant/70 hover:text-primary hover:underline underline-offset-4 normal-case tracking-normal font-normal transition-all duration-200 ease-in-out"
        href={termsPath}
      >
        {t("footer.terms")}
      </a>
    </div>
  </div>
</footer>
