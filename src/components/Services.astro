---
import { useTranslations, type Lang } from "../i18n/utils";
import WhatsAppLink from "./ui/WhatsAppLink.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
  { icon: "smartphone", label: t("services.cat.mobile"), items: t("services.cat.mobile.items"), desc: t("services.cat.mobile.desc") },
  { icon: "smart_toy", label: t("services.cat.ai"), items: t("services.cat.ai.items"), desc: t("services.cat.ai.desc") },
  { icon: "code", label: t("services.cat.backend"), items: t("services.cat.backend.items"), desc: t("services.cat.backend.desc") },
  { icon: "palette", label: t("services.cat.frontend"), items: t("services.cat.frontend.items"), desc: t("services.cat.frontend.desc") },
  { icon: "database", label: t("services.cat.data"), items: t("services.cat.data.items"), desc: t("services.cat.data.desc") },
  { icon: "cloud", label: t("services.cat.devops"), items: t("services.cat.devops.items"), desc: t("services.cat.devops.desc") },
  { icon: "account_tree", label: t("services.cat.architecture"), items: t("services.cat.architecture.items"), desc: t("services.cat.architecture.desc") },
  { icon: "verified_user", label: t("services.cat.quality"), items: t("services.cat.quality.items"), desc: t("services.cat.quality.desc") },
].map((cat) => ({ ...cat, items: cat.items.split(", ") }));

const stationCount = categories.length;
const ingredientCount = categories.reduce((sum, cat) => sum + cat.items.length, 0);

const residenteTitleWords = t("services.residente.title").split(" ");
const residenteTitleFirst = residenteTitleWords[0];
const residenteTitleRest = residenteTitleWords.slice(1).join(" ");

const cartaItems = [
  { icon: "phone_iphone", title: t("services.carta.item1.title"), desc: t("services.carta.item1.desc") },
  { icon: "smart_toy", title: t("services.carta.item2.title"), desc: t("services.carta.item2.desc") },
  { icon: "shopping_cart", title: t("services.carta.item3.title"), desc: t("services.carta.item3.desc") },
  { icon: "sync_alt", title: t("services.carta.item4.title"), desc: t("services.carta.item4.desc") },
  { icon: "bolt", title: t("services.carta.item5.title"), desc: t("services.carta.item5.desc") },
  { icon: "security", title: t("services.carta.item6.title"), desc: t("services.carta.item6.desc") },
  { icon: "api", title: t("services.carta.item7.title"), desc: t("services.carta.item7.desc") },
  { icon: "bar_chart", title: t("services.carta.item8.title"), desc: t("services.carta.item8.desc") },
];
---

<section class="py-section-gap border-t border-outline-variant/30" id="tech">
  <div class="text-center mb-16">
    <h2 class="text-headline-md text-on-background gold-line mx-auto">{t("services.title")}</h2>
    <p class="text-body-md text-on-surface-variant mt-8 max-w-2xl mx-auto">{t("services.subtitle")}</p>
  </div>

  <div class="mb-20">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
      <h3 class="text-headline-sm text-on-background">{t("services.carta.title")}</h3>
      <span class="text-label-caps text-primary tracking-widest">{t("services.carta.tag")}</span>
    </div>
    <p class="text-body-md text-on-surface-variant italic mb-10 max-w-2xl">{t("services.carta.desc")}</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
      {
        cartaItems.map((item) => (
          <div class="bg-surface-container-low p-6 border border-outline-variant rounded-lg hover:border-primary-container transition-colors duration-300">
            <span class="material-symbols-outlined text-primary mb-3 block" aria-hidden="true">
              {item.icon}
            </span>
            <h4 class="text-headline-sm text-on-background mb-2">{item.title}</h4>
            <p class="text-body-md text-on-surface-variant">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div>
    <div class="lg:hidden">
      <div class="border border-outline-variant rounded-lg p-6" id="chef-residente-mobile">
        <span class="text-label-caps text-primary tracking-widest">{t("services.residente.tag")}</span>
        <h3 class="text-headline-sm text-on-background mt-2 mb-3">
          {residenteTitleFirst} <em class="italic text-primary">{residenteTitleRest}</em>
        </h3>
        <p class="text-body-md text-on-surface-variant mb-6">{t("services.residente.desc")}</p>

        <div class="flex items-center gap-3 text-label-caps text-on-surface-variant mb-6">
          <span><span class="text-body-lg text-primary">{stationCount}</span> {t("services.residente.stats.stations")}</span>
          <span class="text-outline-variant">|</span>
          <span><span class="text-body-lg text-primary">{ingredientCount}</span> {t("services.residente.stats.ingredients")}</span>
        </div>

        <div class="border-t border-outline-variant/30">
          {
            categories.map((cat, i) => (
              <div class:list={["border-b border-outline-variant/30 border-l-2", i === 0 ? "border-l-primary" : "border-l-transparent"]}>
                <button
                  type="button"
                  class="accordion-toggle w-full flex justify-between items-center gap-2 py-4 px-2 text-left"
                  data-accordion-toggle={i}
                  aria-expanded={i === 0 ? "true" : "false"}
                >
                  <span class="flex items-baseline gap-3 min-w-0">
                    <span class="text-body-md text-on-surface-variant/60 shrink-0">{String(i + 1).padStart(2, "0")}</span>
                    <span class="text-label-caps truncate">{cat.label}</span>
                  </span>
                  <span class="flex items-center gap-3 shrink-0">
                    <span class="text-body-md text-on-surface-variant/60">{cat.items.length}</span>
                    <span class="material-symbols-outlined accordion-icon text-primary" style="font-size: 20px" aria-hidden="true">
                      {i === 0 ? "remove" : "add"}
                    </span>
                  </span>
                </button>
                <div class:list={["accordion-panel px-2 pb-6", { hidden: i !== 0 }]} data-accordion-panel={i}>
                  <p class="text-body-md text-on-surface-variant mb-4">{cat.desc}</p>
                  <div class="flex items-center gap-3 mb-3">
                    <span class="w-6 h-px bg-primary-container" />
                    <span class="text-label-caps text-on-surface-variant tracking-widest">
                      {t("services.residente.miseEnPlace")}
                    </span>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {cat.items.map((item) => (
                      <span class="text-body-md text-on-background px-3 py-1.5 border border-outline-variant rounded">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="pt-8 flex flex-col items-center gap-3 text-center">
          <WhatsAppLink
            message={t("services.residente.whatsappMessage")}
            class="inline-flex items-center justify-center px-6 py-3 border border-primary text-primary text-label-caps hover:bg-primary hover:text-on-primary transition-all duration-300 rounded"
          >
            {t("services.residente.ctaGeneric")}
          </WhatsAppLink>
          <span class="text-body-md text-on-surface-variant italic">{t("services.residente.ctaNote")}</span>
        </div>
      </div>
    </div>

    <div class="hidden lg:block" id="chef-residente">
      <div class="flex justify-between items-end gap-8 mb-8">
        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
            <h3 class="text-headline-sm text-on-background">{t("services.residente.title")}</h3>
            <span class="text-label-caps text-primary tracking-widest">{t("services.residente.tag")}</span>
          </div>
          <p class="text-body-md text-on-surface-variant italic max-w-2xl">{t("services.residente.desc")}</p>
        </div>
        <div class="flex items-end gap-8 shrink-0">
          <div class="text-right">
            <span class="text-headline-md text-primary block">{stationCount}</span>
            <span class="text-label-caps text-on-surface-variant">{t("services.residente.stats.stations")}</span>
          </div>
          <div class="w-px self-stretch bg-outline-variant" />
          <div class="text-right">
            <span class="text-headline-md text-primary block">{ingredientCount}</span>
            <span class="text-label-caps text-on-surface-variant">{t("services.residente.stats.ingredients")}</span>
          </div>
        </div>
      </div>

      <div class="border-t border-outline-variant/30 flex" id="chef-residente-widget">
        <div class="w-72 shrink-0 border-r border-outline-variant/30">
          {
            categories.map((cat, i) => (
              <button
                type="button"
                class="station-nav-btn w-full flex justify-between items-center gap-2 text-left px-4 py-5 border-b border-outline-variant/30 border-l-2 transition-colors duration-300"
                data-station-index={i}
                aria-current={i === 0 ? "true" : "false"}
              >
                <span class="flex items-baseline gap-3 min-w-0">
                  <span class="text-body-md text-on-surface-variant/60 shrink-0">{String(i + 1).padStart(2, "0")}</span>
                  <span class="text-label-caps truncate">{cat.label}</span>
                </span>
                <span class="text-body-md text-on-surface-variant/60 shrink-0">{cat.items.length}</span>
              </button>
            ))
          }
        </div>

        <div class="flex-1 p-10">
          {
            categories.map((cat, i) => (
              <div class:list={["station-panel", { hidden: i !== 0 }]} data-station-panel={i}>
                <div class="flex items-baseline gap-4 mb-4">
                  <h4 class="text-headline-md text-on-background">{cat.label}</h4>
                  <span class="text-label-caps text-primary tracking-widest">
                    {t("services.residente.stationLabel")} {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <p class="text-body-lg text-on-surface-variant max-w-2xl mb-8">{cat.desc}</p>
                <div class="flex items-center gap-3 mb-4">
                  <span class="w-8 h-px bg-primary-container" />
                  <span class="text-label-caps text-on-surface-variant tracking-widest">
                    {t("services.residente.miseEnPlace")}
                  </span>
                </div>
                <div class="flex flex-wrap gap-3 mb-10">
                  {cat.items.map((item) => (
                    <span class="text-body-md text-on-background px-4 py-2 border border-outline-variant rounded">
                      {item}
                    </span>
                  ))}
                </div>
                <div class="border-t border-outline-variant/30 pt-6 flex items-center gap-6">
                  <WhatsAppLink
                    message={t("services.residente.whatsappMessage")}
                    class="inline-flex items-center justify-center px-6 py-3 border border-primary text-primary text-label-caps hover:bg-primary hover:text-on-primary transition-all duration-300 rounded"
                  >
                    {t("services.residente.cta")}
                  </WhatsAppLink>
                  <span class="text-body-md text-on-surface-variant italic">{t("services.residente.ctaNote")}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initChefResidente() {
    const widget = document.getElementById("chef-residente-widget");
    if (!widget) return;

    const buttons = Array.from(widget.querySelectorAll<HTMLButtonElement>(".station-nav-btn"));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>(".station-panel"));
    if (!buttons.length || !panels.length) return;

    let autoplayId: ReturnType<typeof setInterval> | null = null;
    let current = 0;

    const setActive = (index: number) => {
      current = index;
      buttons.forEach((btn) => {
        const isActive = Number(btn.dataset.stationIndex) === index;
        btn.classList.toggle("bg-surface-container-low", isActive);
        btn.classList.toggle("border-l-primary", isActive);
        btn.classList.toggle("border-l-transparent", !isActive);
        btn.setAttribute("aria-current", String(isActive));
      });
      panels.forEach((panel) => {
        panel.classList.toggle("hidden", Number(panel.dataset.stationPanel) !== index);
      });
    };

    const stopAutoplay = () => {
      if (autoplayId !== null) {
        clearInterval(autoplayId);
        autoplayId = null;
      }
    };

    setActive(0);
    autoplayId = setInterval(() => setActive((current + 1) % buttons.length), 5000);

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        stopAutoplay();
        setActive(Number(btn.dataset.stationIndex));
      });
    });
  }

  function initChefResidenteAccordion() {
    const root = document.getElementById("chef-residente-mobile");
    if (!root) return;

    const toggles = Array.from(root.querySelectorAll<HTMLButtonElement>(".accordion-toggle"));
    if (!toggles.length) return;

    const setOpen = (index: number) => {
      toggles.forEach((toggle) => {
        const i = Number(toggle.dataset.accordionToggle);
        const isOpen = i === index;
        const item = toggle.closest("div");
        const panel = item?.querySelector<HTMLElement>(`[data-accordion-panel="${i}"]`);
        const icon = toggle.querySelector(".accordion-icon");

        toggle.setAttribute("aria-expanded", String(isOpen));
        item?.classList.toggle("border-l-primary", isOpen);
        item?.classList.toggle("border-l-transparent", !isOpen);
        panel?.classList.toggle("hidden", !isOpen);
        if (icon) icon.textContent = isOpen ? "remove" : "add";
      });
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const index = Number(toggle.dataset.accordionToggle);
        const isCurrentlyOpen = toggle.getAttribute("aria-expanded") === "true";
        setOpen(isCurrentlyOpen ? -1 : index);
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initChefResidente);
  document.addEventListener("DOMContentLoaded", initChefResidenteAccordion);
</script>
