---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { icon: "search", title: t("process.step1.title"), desc: t("process.step1.desc") },
  { icon: "terminal", title: t("process.step2.title"), desc: t("process.step2.desc") },
  { icon: "local_shipping", title: t("process.step3.title"), desc: t("process.step3.desc") },
] as const;
---

<section class="py-section-gap border-t border-outline-variant/30" id="process">
  <div class="text-center mb-16">
    <h2 class="text-headline-md text-on-background gold-line mx-auto">{t("process.title")}</h2>
    <p class="text-body-md text-on-surface-variant mt-8 max-w-2xl mx-auto">{t("process.subtitle")}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter relative">
    {
      steps.map((step, i) => (
        <div class="relative p-8 border border-outline-variant rounded-lg bg-surface-container-low">
          <div class="flex items-center gap-4 mb-4">
            <span class="w-12 h-12 rounded-full border border-outline-variant/60 bg-surface-container flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-primary" aria-hidden="true">
                {step.icon}
              </span>
            </span>
            <span class="text-headline-sm font-serif text-on-surface-variant/40 tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <h3 class="text-headline-sm text-on-background mb-2">{step.title}</h3>
          <p class="text-body-md text-on-surface-variant">{step.desc}</p>
        </div>
      ))
    }
  </div>
</section>
