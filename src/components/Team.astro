---
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "../i18n/utils";
import teamBanner from "../assets/images/microchip-tweezers.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const members = [
  {
    role: t("team.member1.role"),
    tag: t("team.member1.tag"),
    desc: t("team.member1.desc"),
  },
  {
    role: t("team.member2.role"),
    tag: t("team.member2.tag"),
    desc: t("team.member2.desc"),
  },
  {
    role: t("team.member3.role"),
    tag: t("team.member3.tag"),
    desc: t("team.member3.desc"),
  },
  {
    role: t("team.member4.role"),
    tag: t("team.member4.tag"),
    desc: t("team.member4.desc"),
  },
];
---

<section class="py-section-gap border-t border-outline-variant/30" id="team">
  <div class="text-center mb-16">
    <h2 class="text-headline-md text-on-background gold-line mx-auto">{t("team.title")}</h2>
    <p class="text-body-md text-on-surface-variant mt-8 max-w-2xl mx-auto">{t("team.subtitle")}</p>
  </div>

  <div class="mb-16 rounded-lg overflow-hidden border border-outline-variant/30 aspect-[21/9]">
    <Image
      alt={t("team.image.alt")}
      class="w-full h-full object-cover opacity-90"
      src={teamBanner}
      loading="lazy"
      widths={[640, 1280, 1920]}
      sizes="100vw"
    />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
    {
      members.map((member) => (
        <div class="bg-surface-container-low p-8 border border-outline-variant rounded-lg hover:border-primary-container transition-colors duration-300 group">
          <div
            class="w-32 h-32 mx-auto mb-6 rounded-lg bg-primary-container/30 border border-outline-variant flex items-center justify-center"
          >
            <span class="material-symbols-outlined text-primary text-5xl" aria-hidden="true">person</span>
          </div>
          <h3 class="text-headline-sm text-on-background mb-2">{member.role}</h3>
          <span class="text-label-caps text-primary mb-4 block">{member.tag}</span>
          <p class="text-body-md text-on-surface-variant">{member.desc}</p>
        </div>
      ))
    }
  </div>
</section>
