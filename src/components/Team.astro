  },
  {
    role: t("team.member3.role"),
    tag: t("team.member3.tag"),
    desc: t("team.member3.desc"),
    img: "https://lh3.googleusercontent.com/aida-public/AB6AXuCSBhgE4ti4Q2T1WmSx01HmDLD-in9-VGpOz7YDGx8WgodR0Mt2nsQfUQnmYJEjvEuAh6wM4Kjg_rlOFpBViD1zgTVaLyQAP7Sj2zfMjuzp0IgJxBUE59yG0y0nKFQVDfgoHHX1X5DUQoHfoLMrP50BKlYAOpj-_b4vYAVNqkTMFVzXiXnAQsyQIinq56kCRMTyMT6gM-8OM1hznpXDYED3TQaEHv-FRQ3rUw5EnJhALztKlwi72GimIg",
