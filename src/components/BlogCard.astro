---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FormattedDate from "./ui/FormattedDate.astro";

interface Props {
  title: string;
  description: string;
  category: string;
  categoryUrl: string;
  url: string;
  pubDate: Date;
  readingTime?: number;
  heroImage?: ImageMetadata;
}

const { title, description, category, categoryUrl, url, pubDate, readingTime, heroImage } = Astro.props;
---

<article class="flex flex-col group">
  <a href={url} class="aspect-video mb-6 overflow-hidden rounded-lg border border-outline-variant/30 block">
    {
      heroImage && (
        <Image
          alt={title}
          class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105"
          src={heroImage}
          loading="lazy"
          widths={[400, 640, 960]}
          sizes="(min-width: 768px) 33vw, 100vw"
        />
      )
    }
  </a>
  <a href={categoryUrl} class="text-label-caps text-primary mb-2 hover:underline underline-offset-4 self-start">
    {category}
  </a>
  <h3 class="text-headline-sm text-on-background mb-2">
    <a href={url} class="hover:text-primary transition-colors duration-300">{title}</a>
  </h3>
  <div class="text-label-caps text-on-surface-variant/70 mb-4 flex items-center gap-2 normal-case tracking-normal font-normal">
    <FormattedDate date={pubDate} />
    {readingTime && <span>· {readingTime} min de lectura</span>}
  </div>
  <p class="text-body-md text-on-surface-variant mb-6 grow">{description}</p>
  <a
    class="text-label-caps text-on-background border-b border-primary pb-1 self-start hover:text-primary transition-colors duration-300"
    href={url}
  >
    Leer Crónica
  </a>
</article>
