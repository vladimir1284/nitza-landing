---
import { Image } from "astro:assets";
import { useTranslations, getLocalizedPath, type Lang } from "../i18n/utils";
import cloche from "../assets/images/cloche.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const reservation = `${getLocalizedPath(lang, "/")}#reservation`;
---

<section class="py-section-gap flex flex-col items-center text-center" id="hero">
  <div class="max-w-3xl mb-12">
    <h1
      class="text-display-lg-mobile md:text-display-lg text-on-background mb-6 gold-line mx-auto before:content-[''] before:block before:w-16 before:h-1 before:bg-primary-container before:mx-auto before:mb-8"
    >
      {t("hero.title")}
    </h1>
    <p class="text-body-lg text-on-surface-variant mt-10">{t("hero.subtitle")}</p>
    <div class="mt-12">
      <a
        class="inline-flex items-center justify-center px-8 py-4 bg-on-primary-fixed text-primary-fixed border border-on-primary-fixed text-label-caps hover:bg-primary-container hover:text-on-background transition-all duration-300 rounded"
        href={reservation}
      >
        {t("hero.cta")}
      </a>
    </div>
  </div>

  <div
    class="relative w-full max-w-2xl aspect-video mt-8 group cursor-pointer overflow-hidden rounded-lg bg-surface-container-low border border-outline-variant flex items-center justify-center"
  >
    <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent z-10 pointer-events-none"></div>
    <div class="relative z-20 flex flex-col items-center w-full h-full">
      <Image
        alt={t("hero.image.alt")}
        class="w-full h-full object-cover rounded-lg shadow-2xl cloche-reveal"
        src={cloche}
        loading="eager"
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 672px, 100vw"
      />
    </div>
  </div>
</section>
