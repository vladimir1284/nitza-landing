---
import { useTranslations, type Lang } from "../i18n/utils";
import type { ui, defaultLang } from "../i18n/ui";
import WhatsAppLink from "./ui/WhatsAppLink.astro";

type TranslationKey = keyof (typeof ui)[typeof defaultLang];

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { key: "item1", icon: "code" },
  { key: "item2", icon: "rocket" },
  { key: "item3", icon: "migrate" },
  { key: "item4", icon: "compass" },
] as const;
---

<section class="pt-10 pb-section-gap md:pt-12 md:pb-section-gap grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-stretch" id="hero">
  <div class="text-left">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-px bg-primary-container" aria-hidden="true"></span>
      <span class="text-label-caps text-primary">{t("hero.kicker")}</span>
    </div>

    <h1 class="hero-heading text-on-background">
      {t("hero.title.pre")} <em class="italic text-primary">{t("hero.title.highlight")}</em>{t("hero.title.post")}
    </h1>

    <p class="text-body-lg text-on-surface-variant mt-6 max-w-prose">{t("hero.subtitle")}</p>

    <div class="mt-8 flex flex-col sm:flex-row gap-4">
      <WhatsAppLink message={t("cta.whatsappMessage")} class="inline-flex items-center justify-center px-8 py-4 bg-on-primary-fixed text-primary-fixed border border-on-primary-fixed text-label-caps hover:bg-primary-container hover:text-on-background transition-all duration-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        {t("hero.cta")}
      </WhatsAppLink>
      <a href="#menu" class="inline-flex items-center justify-center px-6 py-3 border border-primary text-primary text-label-caps hover:bg-primary hover:text-on-primary transition-all duration-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        {t("hero.secondaryCta")}
      </a>
    </div>

    <div class="mt-10 pt-8 border-t border-outline-variant/30 flex flex-wrap gap-x-6 gap-y-4">
      <div class="pl-0">
        <div class="hero-stat-value text-on-background tabular-nums">{t("hero.stat1.value")}</div>
        <div class="text-label-caps text-on-surface-variant mt-1">{t("hero.stat1.label")}</div>
      </div>
      <div class="pl-6 border-l border-outline-variant/30">
        <div class="hero-stat-value text-on-background tabular-nums">{t("hero.stat2.value")}</div>
        <div class="text-label-caps text-on-surface-variant mt-1">{t("hero.stat2.label")}</div>
      </div>
      <div class="pl-6 border-l border-outline-variant/30">
        <div class="hero-stat-value text-on-background tabular-nums">{t("hero.stat3.value")}</div>
        <div class="text-label-caps text-on-surface-variant mt-1">{t("hero.stat3.label")}</div>
      </div>
    </div>
  </div>

  <div id="menu" class="h-full flex flex-col justify-center bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm relative overflow-hidden p-10 md:p-14">
    <div class="absolute top-4 left-4 w-4 h-4 border-t border-l border-primary-container"></div>
    <div class="absolute top-4 right-4 w-4 h-4 border-t border-r border-primary-container"></div>
    <div class="absolute bottom-4 left-4 w-4 h-4 border-b border-l border-primary-container"></div>
    <div class="absolute bottom-4 right-4 w-4 h-4 border-b border-r border-primary-container"></div>

    <div class="text-center mb-12">
      <h2 class="text-headline-md text-on-background font-serif italic">{t("nav.menu")}</h2>
      <div class="w-12 h-px bg-primary mx-auto mt-4"></div>
    </div>

    <div class="space-y-7">
      {
        services.map((service) => (
          <div>
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-full border border-outline-variant/30 bg-surface-container flex items-center justify-center shrink-0">
                <svg
                  class="w-5 h-5 text-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                {service.icon === "code" && (
                  <path d="M9 9l-3 3 3 3M15 9l3 3-3 3M13.5 7l-3 10" stroke-linecap="round" stroke-linejoin="round" />
                )}
                {service.icon === "rocket" && (
                  <>
                    <path
                      d="M12 3.5c2.2 1.4 3.6 3.9 3.6 6.9 0 1.8-.5 3.5-1.4 4.8L12 17.5l-2.2-2.3c-.9-1.3-1.4-3-1.4-4.8 0-3 1.4-5.5 3.6-6.9z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <circle cx="12" cy="9.5" r="1.3" />
                    <path d="M9.2 14.5 7.5 18.5l3-1.2M14.8 14.5l1.7 4-3-1.2" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                )}
                {service.icon === "migrate" && (
                  <>
                    <rect x="4.2" y="9.5" width="5" height="6" rx="0.5" />
                    <path d="M6.7 11.5v2" stroke-linecap="round" />
                    <path d="M10.5 12.5h6.3" stroke-linecap="round" />
                    <path d="M14.5 10.2l2.8 2.3-2.8 2.3" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="17.8" y="9" width="5.2" height="7" rx="1.4" />
                    <path d="M19.4 11.3h2" stroke-linecap="round" />
                    <path d="M19.4 13.7h2" stroke-linecap="round" />
                  </>
                )}
                {service.icon === "compass" && (
                  <>
                    <circle cx="12" cy="12" r="6.3" />
                    <path d="M14.6 9.4l-1.4 3.6-3.6 1.4 1.4-3.6z" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                )}
              </svg>
            </div>
              <h3 class="text-body-lg text-on-background">{t(`menu.${service.key}.title` as TranslationKey)}</h3>
            </div>
            <p class="text-body-md text-on-surface-variant italic">{t(`menu.${service.key}.desc` as TranslationKey)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-heading {
    font-family: "Cormorant Garamond", serif;
    font-weight: 400;
    font-size: 52px;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .hero-stat-value {
    font-family: "Cormorant Garamond", serif;
    font-weight: 500;
    font-size: 32px;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .hero-heading {
      font-size: 84px;
    }
  }
</style>
