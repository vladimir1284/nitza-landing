          <clipPath id="hg-upper"><rect x="360" y="100" width="430" height="352"/></clipPath>
          <clipPath id="hg-lower"><rect x="360" y="448" width="430" height="372"/></clipPath>
        </defs>
        <g class="hg__rotor">
          <path class="hg__glass" fill="#F2E6D2" d="M381.83 27.6555C401.302 26.8147 424.925 27.5152 444.755 27.5442L577.586 28.0148L710.093 27.5562C730.004 27.5176 753.566 26.895 773.054 27.6546L822.288 27.5285C827.287 27.5184 842.343 27.196 846.157 28.0623C868.827 30.8547 873.234 51.9084 871.874 70.7092C871.535 75.4061 872.298 80.5197 871.443 85.2518C869.476 99.9169 859.487 109.318 844.992 110.954C839.792 111.585 832.504 111.231 827.07 111.185C826.91 120.05 825.466 158.291 823.505 165.56C822.349 178.967 814.864 222.716 809.724 234.34C794.084 285.68 772.247 326.142 737.568 367.408C734.034 371.614 722.925 385.178 719.291 388.363C697.48 414.202 667.235 436.333 669.956 472.008C670.04 472.162 670.124 472.316 670.209 472.469C673.61 485.947 681.412 492.58 690.637 502.193C699.334 511.137 707.903 520.204 716.341 529.393C762.3 580.085 793.023 631.117 810.582 697.856C820.375 737.442 825.038 771.416 825.185 812.496C838.282 812.451 853.526 810.543 863.236 820.422C871.756 829.09 871.477 840.667 871.391 851.854L871.269 861.255C871.943 870.229 869.623 879.375 863.063 885.912C855.025 893.921 847.912 893.763 837.296 893.794L472.391 893.787L355.92 893.78L320.583 893.776C307.728 893.774 293.405 895.931 283.686 885.943C272.392 874.383 276.257 858.669 275.505 844.157C274.68 828.219 284.198 813.836 300.927 812.573C307.515 812.076 314.85 812.459 321.542 812.532C321.786 741.863 336.058 675.218 370.228 612.841C388.31 579.833 411.389 552.104 436.813 524.591C447.854 512.209 460.665 501.275 470.279 487.728C481.562 472.289 478.703 453.203 468.1 438.152C456.821 422.139 442.39 407.414 429.123 392.82C404.272 365.484 383.034 337.823 365.376 305.217C332.856 245.169 319.917 178.752 319.41 110.905C307.649 111.168 295.928 112.406 285.963 104.71C271.863 93.9026 276.059 76.2092 275.433 60.92C274.76 44.4485 283.951 29.8327 301.232 28.0528C304.997 27.2484 321.794 27.5432 326.858 27.5503L381.83 27.6555Z"/>
