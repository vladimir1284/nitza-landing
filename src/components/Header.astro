---
import { useTranslations, getLocalizedPath, type Lang } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import WhatsAppLink from "./ui/WhatsAppLink.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath(lang, "/");
---

<nav class="w-full top-0 sticky bg-background border-b border-outline-variant z-50">
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-unit max-w-container-max mx-auto"
  >
    <div class="flex items-center">
      <img src="/logo.svg" alt="" class="w-12 h-12" aria-hidden="true" />
      <a
        class="text-2xl md:text-3xl text-primary font-script font-normal normal-case hover:text-primary transition-colors duration-300"
        href={home}
      >
        {t("nav.brand")}
      </a>
    </div>
    <div class="hidden md:flex gap-8 items-center">
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#hero`}
        data-section="hero"
      >
        {t("nav.home")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#menu`}
        data-section="menu"
      >
        {t("nav.menu")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#blog`}
        data-section="blog"
      >
        {t("nav.blog")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#team`}
        data-section="team"
      >
        {t("nav.team")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#tech`}
        data-section="tech"
      >
        {t("nav.tech")}
      </a>
    </div>
    <div class="flex items-center gap-2">
      <LanguageToggle lang={lang} />
      <ThemeToggle lang={lang} />
      <WhatsAppLink
        message={t("cta.whatsappMessage")}
        class="inline-flex items-center justify-center px-6 py-3 bg-on-primary-fixed text-primary-fixed border border-on-primary-fixed text-label-caps hover:bg-primary-container hover:text-on-background hover:border-primary-container transition-all duration-300 rounded"
      >
        {t("nav.reserve")}
      </WhatsAppLink>
    </div>
  </div>
</nav>

<script>
  function initScrollSpy() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link[data-section]");
    if (!navLinks.length) return;

    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(link.dataset.section ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      navLinks.forEach((link) => {
        const isActive = link.dataset.section === id;
        link.classList.toggle("text-primary", isActive);
        link.classList.toggle("border-primary", isActive);
        link.classList.toggle("text-on-surface-variant", !isActive);
        link.classList.toggle("border-transparent", !isActive);
      });
    };

    const nav = document.querySelector("nav");
    const navHeight = nav instanceof HTMLElement ? nav.offsetHeight : 0;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      {
        rootMargin: `-${navHeight}px 0px -60% 0px`,
        threshold: [0, 0.25, 0.5, 0.75, 1],
      }
    );

    sections.forEach((section) => observer.observe(section));
  }

  document.addEventListener("DOMContentLoaded", initScrollSpy);
</script>
