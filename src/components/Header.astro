        href={home}
      >
        {t("nav.brand")}
      </a>
    </div>
    <div class="hidden md:flex gap-8 items-center">
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#hero`}
        data-section="hero"
      >
        {t("nav.home")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#blog`}
        data-section="blog"
      >
        {t("nav.blog")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#portfolio`}
        data-section="portfolio"
      >
        {t("nav.portfolio")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#team`}
        data-section="team"
      >
        {t("nav.team")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
        href={`${home}#tech`}
        data-section="tech"
      >
        {t("nav.tech")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant border-b-2 border-transparent pb-1 hover:text-primary transition-colors duration-300"
