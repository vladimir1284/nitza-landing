---
import { useTranslations, getLocalizedPath, type Lang } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import WhatsAppLink from "./ui/WhatsAppLink.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath(lang, "/");
---

<nav class="w-full top-0 sticky bg-background border-b border-outline-variant z-50">
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-unit max-w-container-max mx-auto"
  >
    <div class="flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="hg w-12 h-12" viewBox="0 0 1152 928" role="img" aria-hidden="true">
        <style>
          .hg {
            --hg-sand: #C8933F;
            --hg-glass: #F2E6D2;
            --hg-rim: 20;
            --hg-turn: 10s;
            --hg-loop: calc(var(--hg-turn) * 2);
            overflow: visible;
          }
          .hg__glass { fill: var(--hg-glass, #F2E6D2); }
          .hg__sand { fill: var(--hg-sand, #C8933F); }
          .hg__stream { fill: var(--hg-sand, #C8933F); opacity: 0; }
          .hg__frame { fill: url(#hg-frame-grad); }
          .hg__rim {
            fill: none;
            stroke: var(--hg-glass, #F2E6D2);
            stroke-width: calc(var(--hg-rim) * 2);
            stroke-linejoin: round;
          }
          .hg__rotor {
            transform-box: view-box;
            transform-origin: 576px 464px;
            animation: hg-flip var(--hg-loop) linear infinite;
          }
          .hg__sand--top { animation: hg-top var(--hg-loop) linear infinite; }
          .hg__sand--bottom { animation: hg-bottom var(--hg-loop) linear infinite; }
          .hg__stream--a { animation: hg-stream-a var(--hg-loop) linear infinite; }
          .hg__stream--b { animation: hg-stream-b var(--hg-loop) linear infinite; }
          @keyframes hg-flip {
            0% { transform: rotate(0deg); }
            42.5% { transform: rotate(0deg); animation-timing-function: cubic-bezier(.65,0,.35,1); }
            47.5% { transform: rotate(180deg); }
            92.5% { transform: rotate(180deg); animation-timing-function: cubic-bezier(.65,0,.35,1); }
            97.5% { transform: rotate(360deg); }
            100% { transform: rotate(360deg); }
          }
          @keyframes hg-top {
            0% { transform: translateY(0); }
            42.5% { transform: translateY(345px); }
            47.5% { transform: translateY(345px); }
            47.6% { transform: translateY(-345px); }
            50% { transform: translateY(-345px); }
            92.5% { transform: translateY(0); }
            100% { transform: translateY(0); }
          }
          @keyframes hg-bottom {
            0% { transform: translateY(360px); }
            42.5% { transform: translateY(0); }
            50% { transform: translateY(0); }
            92.5% { transform: translateY(-360px); }
            97.5% { transform: translateY(-360px); }
            97.6% { transform: translateY(360px); }
            100% { transform: translateY(360px); }
          }
          @keyframes hg-stream-a {
            0% { opacity: 0; } 3% { opacity: .85; }
            41% { opacity: .85; } 42.5% { opacity: 0; } 100% { opacity: 0; }
          }
          @keyframes hg-stream-b {
            0% { opacity: 0; } 50% { opacity: 0; } 53% { opacity: .85; }
            91% { opacity: .85; } 92.5% { opacity: 0; } 100% { opacity: 0; }
          }
          @media (prefers-reduced-motion: reduce) {
            .hg * { animation: none; }
            .hg__sand--top { transform: translateY(172px); }
            .hg__sand--bottom { transform: translateY(180px); }
            .hg__stream--a { opacity: .85; }
          }
        </style>
        <defs>
          <linearGradient id="hg-frame-grad" gradientUnits="userSpaceOnUse" x1="205.00662" y1="540.67932" x2="941.41248" y2="380.43961"><stop offset="0" stop-color="#593E0A"/><stop offset="1" stop-color="#775314"/></linearGradient>
          <path id="hg-arm" d="M381.83 27.6555C401.302 26.8147 424.925 27.5152 444.755 27.5442L577.586 28.0148L710.093 27.5562C730.004 27.5176 753.566 26.895 773.054 27.6546L822.288 27.5285C827.287 27.5184 842.343 27.196 846.157 28.0623C868.827 30.8547 873.234 51.9084 871.874 70.7092C871.535 75.4061 872.298 80.5197 871.443 85.2518C869.476 99.9169 859.487 109.318 844.992 110.954C840.976 110.918 819.423 110.57 816.851 111.254C811.792 111.796 803.348 111.232 798.007 111.168L764.35 110.991L382.329 110.991C382.997 183.018 397.252 247.507 439.217 307.212C446.667 317.662 454.574 327.78 462.915 337.535C464.881 339.836 475.552 351.688 476.566 353.308C482.305 358.901 487.591 365.301 493.122 371.121C515.866 395.051 539.852 430.645 537.624 465.483C538.459 511.143 506.772 538.788 478.429 569.752C465.265 584.134 450.919 601.382 439.849 617.234C399.498 675.017 382.177 742.446 382.542 812.565L485.313 812.511C502.723 812.515 523.525 811.989 540.787 812.663C546.203 812.176 555.875 812.527 561.543 812.563L600.013 812.719L637.999 812.555C642.355 812.533 652.767 812.206 656.751 812.676C668.071 812.22 681.399 812.526 692.873 812.528L764.408 812.443C764.357 772.935 759.769 742.212 749.56 704.527C748.335 702.224 746.529 696.337 745.652 693.69C731.07 649.676 705.627 610.129 674.661 575.862C671.419 572.274 667.545 568.459 664.557 564.543L664.236 564.113C663.791 563.09 663.334 562.074 662.863 561.063C663.748 560.013 664.883 559.974 666.285 559.658C667.456 558.465 668.891 556.651 670.306 556.175C671.518 557.885 671.416 557.64 672.91 558.82C678.484 563.227 684.182 570.668 688.782 575.936C724.433 616.277 750.085 664.443 763.66 716.537C765.455 723.255 769.009 741.888 770.801 746.615L771.486 746.701C775.559 743.175 803.02 747.925 810.073 748.468C808.801 741.344 808.046 734.269 806.614 727.063C804.094 714.388 800.879 702.244 797.306 689.856C802.494 694.221 796.152 704.331 809.094 700.913C810.45 699.574 810.031 699.967 810.582 697.856C820.375 737.442 825.038 771.416 825.185 812.496C838.282 812.451 8