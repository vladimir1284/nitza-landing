  <div id="mobile-menu" class="md:hidden hidden border-t border-outline-variant px-margin-mobile py-6">
    <div class="flex flex-col">
      <a
        class="nav-link text-label-caps text-on-surface-variant py-3 border-b border-outline-variant/30 hover:text-primary transition-colors duration-300"
        href={`${home}#hero`}
        data-section="hero"
      >
        {t("nav.home")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant py-3 border-b border-outline-variant/30 hover:text-primary transition-colors duration-300"
        href={`${home}#blog`}
        data-section="blog"
      >
        {t("nav.blog")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant py-3 border-b border-outline-variant/30 hover:text-primary transition-colors duration-300"
        href={`${home}#portfolio`}
        data-section="portfolio"
      >
        {t("nav.portfolio")}
      </a>
      <a
        class="nav-link text-label-caps text-on-surface-variant py-3 border-b border-outline-variant/30 hover:text-primary transition-colors duration-300"
        href={`${home}#team`}
        data-section="team"
      >
        {t("nav.team")}
      </a>
