---
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "../i18n/utils";
import WhatsAppLink from "./ui/WhatsAppLink.astro";
import arielAvatar from "../assets/images/testimonials/ariel.jpeg";
import orlandoAvatar from "../assets/images/testimonials/orlando.jpeg";
import dajerAvatar from "../assets/images/testimonials/dajer.jpeg";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonials = [
  {
    quote: t("testimonials.quote1"),
    role: t("testimonials.role1"),
    company: t("testimonials.company1"),
    tag: t("testimonials.tag1"),
    avatar: arielAvatar,
    pending: true, // consentimiento de nombre/logo pendiente — ver comentario junto a testimonials.quote1 en ui.ts
  },
  {
    quote: t("testimonials.quote2"),
    role: t("testimonials.role2"),
    company: t("testimonials.company2"),
    tag: t("testimonials.tag2"),
    avatar: orlandoAvatar,
    pending: false,
  },
  {
    quote: t("testimonials.quote3"),
    role: t("testimonials.role3"),
    company: t("testimonials.company3"),
    tag: t("testimonials.tag3"),
    avatar: dajerAvatar,
    pending: true, // consentimiento de nombre/logo pendiente — ver comentario junto a testimonials.quote3 en ui.ts
  },
];
---

<section class="py-section-gap border-t border-outline-variant/30" id="testimonials">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px bg-primary-container" aria-hidden="true"></span>
        <span class="text-label-caps text-primary">{t("testimonials.kicker")}</span>
      </div>
      <h2 class="text-headline-md text-on-background font-serif italic">
        {t("testimonials.title.pre")} <span class="text-primary">{t("testimonials.title.highlight")}</span>
      </h2>
    </div>
    <p class="text-body-md text-on-surface-variant italic md:text-right max-w-sm">{t("testimonials.subtitle")}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 border-t border-outline-variant/30">
    {
      testimonials.map((item, i) => (
        <div
          class:list={[
            "flex flex-col h-full p-8 md:p-10 border-b border-outline-variant/30 md:border-b-0",
            i > 0 && "md:border-l md:border-outline-variant/30",
          ]}
        >
          <div class="flex items-start justify-between mb-4">
            <span class="material-symbols-outlined text-primary-container opacity-30 text-display-lg" aria-hidden="true">
              format_quote
            </span>
            <span class="text-body-md text-on-surface-variant/40">{String(i + 1).padStart(2, "0")}</span>
          </div>

          <blockquote
            class="text-headline-sm font-serif italic text-on-background mb-10 grow"
            set:html={item.quote.replace("Nitza Develop", '<span class="font-script not-italic text-[1.15em] font-normal">Nitza Develop</span>')}
          />

          <div class="flex items-center gap-4 pt-6 border-t border-outline-variant/30 mt-auto">
            <div class="w-14 h-14 rounded-full overflow-hidden border border-outline-variant/60 shrink-0 bg-surface-container-high">
              <Image
                src={item.avatar}
                alt={`${item.role} — ${item.company}`}
                class="w-full h-full object-cover"
                width={112}
                height={112}
                loading="lazy"
              />
            </div>
            <div class="min-w-0 flex-1">
              <cite class="text-label-caps text-on-background not-italic block truncate" title={item.role}>{item.role}</cite>
              <p
                class:list={["text-body-md italic truncate", item.pending ? "text-on-surface-variant" : "text-primary"]}
                title={item.company}
              >
                {item.company}
              </p>
              <p class="text-label-caps text-on-surface-variant/60 mt-1 truncate" title={`${t("testimonials.triedLabel")} · ${item.tag}`}>
                {t("testimonials.triedLabel")} · {item.tag}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mt-12">
    <p class="text-body-md text-on-surface-variant italic">{t("testimonials.footnote")}</p>
    <WhatsAppLink
      message={t("testimonials.whatsappMessage")}
      class="inline-flex items-center justify-center px-6 py-3 border border-primary text-primary text-label-caps hover:bg-primary hover:text-on-primary transition-all duration-300 rounded shrink-0"
    >
      {t("testimonials.cta")}
    </WhatsAppLink>
  </div>
</section>
