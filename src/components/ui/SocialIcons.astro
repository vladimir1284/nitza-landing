---
import { SOCIAL_LINKS, WHATSAPP_NUMBER } from "../../lib/contact";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const links = [
  { key: "linkedin", href: SOCIAL_LINKS.linkedin, label: "LinkedIn" },
  { key: "whatsapp", href: `https://wa.me/${WHATSAPP_NUMBER}`, label: "WhatsApp" },
  { key: "telegram", href: `https://t.me/+${WHATSAPP_NUMBER}`, label: "Telegram" },
  { key: "x", href: SOCIAL_LINKS.x, label: "X" },
  { key: "facebook", href: SOCIAL_LINKS.facebook, label: "Facebook" },
  { key: "tiktok", href: SOCIAL_LINKS.tiktok, label: "TikTok" },
];

const icons: Record<string, string> = {
  linkedin:
    "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.64h.05c.53-1 1.83-2.05 3.77-2.05C21.9 8.59 23 11 23 14.7V21h-4v-5.6c0-1.33-.02-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95V21h-4V9z",
