    "M21.9 4.6 3.7 11.7c-1.2.5-1.2 1.2-.2 1.5l4.6 1.4 1.8 5.4c.2.6.4.8.9.8.4 0 .6-.2.9-.5l2.1-2 4.4 3.2c.8.5 1.4.2 1.6-.7l2.9-13.7c.3-1.2-.4-1.7-1.4-1.5zM8.9 14.3 18 8.6c.4-.3.8 0 .5.3L11 15.8l-.3 3.1-1.8-4.6z",
  x: "M18.9 3H22l-7.2 8.2L23 21h-6.9l-5.4-6.7L4.4 21H1.3l7.7-8.8L1 3h7l4.9 6.1L18.9 3zM17.7 19h1.9L6.4 5H4.4L17.7 19z",
