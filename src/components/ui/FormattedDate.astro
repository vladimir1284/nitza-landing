---
import type { Lang } from "../../i18n/utils";

interface Props {
  date: Date;
  lang?: Lang;
}

const { date, lang = "es" } = Astro.props;
const locale = lang === "en" ? "en-US" : "es-ES";
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale, {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    })
  }
</time>
